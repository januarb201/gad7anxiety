
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Self Check Depresi PHQ-9</title>
<style>
*{box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#f4f6fa;color:#222;margin:0;padding:20px}
main{max-width:650px;margin:auto}
h1{color:#234f9d;font-size:29px}
.card{background:white;padding:18px;border-radius:14px;margin:15px 0}
.q{padding:15px 0;border-bottom:1px solid #ddd}
label{display:block;padding:10px;margin:6px 0;background:#f5f7fa;border-radius:8px;cursor:pointer}
input{margin-right:9px;accent-color:#234f9d}
button{width:100%;padding:14px;background:#234f9d;color:white;border:0;border-radius:9px;font-size:16px}
button:disabled{background:#aaa}
#hasil{display:none}
.score{font-size:42px;font-weight:bold;color:#234f9d}
small{color:#666;line-height:1.5}
</style>
</head>
<body>
<main>

<h1>Self Check Depresi</h1>
<p><b>PHQ-9 – Patient Health Questionnaire</b></p>
<p>Selama <b>2 minggu terakhir</b>, seberapa sering kamu mengalami hal-hal berikut?</p>

<div class="card">
<form id="tes">
<div id="pertanyaan"></div>
<button id="btn" disabled>Lihat Hasil</button>
</form>
</div>

<div class="card" id="hasil">
<h2>Hasil Skrining PHQ-9</h2>
<div class="score" id="skor"></div>
<h3 id="kategori"></h3>
<p id="keterangan"></p>
<hr>
<p><b>Interpretasi skor:</b></p>
<p>
0–4: Minimal<br>
5–9: Ringan<br>
10–14: Sedang<br>
15–19: Cukup berat<br>
20–27: Berat
</p>
<p id="catatan9"></p>
<button type="button" onclick="ulang()">Ulangi Tes</button>
</div>

<div class="card">
<small>
PHQ-9 adalah alat skrining awal, bukan diagnosis.
Jika jawaban pertanyaan nomor 9 lebih dari 0,
segera bicarakan dengan orang tepercaya dan tenaga
kesehatan profesional agar kondisimu dapat dinilai lebih lanjut.
</small>
</div>

<p><small>PHQ-9 · Kroenke, Spitzer & Williams (2001)</small></p>

</main>

<script>
const soal=[
"Kurang berminat atau kurang menikmati melakukan berbagai hal.",
"Merasa sedih, murung, tertekan, atau putus asa.",
"Sulit tidur, sering terbangun, tidur tidak nyenyak, atau justru terlalu banyak tidur.",
"Merasa lelah atau kurang bertenaga.",
"Kurang nafsu makan atau makan terlalu banyak.",
"Merasa buruk tentang diri sendiri — merasa gagal atau mengecewakan diri sendiri maupun keluarga.",
"Sulit berkonsentrasi pada sesuatu, misalnya membaca atau menonton televisi.",
"Bergerak atau berbicara sangat lambat hingga orang lain menyadarinya. Atau sebaliknya, sangat gelisah hingga lebih banyak bergerak dari biasanya.",
"Terpikir lebih baik mati atau ingin menyakiti diri sendiri dengan suatu cara."
];

const jawaban=[
"Tidak pernah",
"Beberapa hari",
"Lebih dari separuh hari",
"Hampir setiap hari"
];

const area=document.getElementById("pertanyaan");

soal.forEach((s,i)=>{
 let d=document.createElement("div");
 d.className="q";

 let b=document.createElement("b");
 b.textContent=(i+1)+". "+s;
 d.appendChild(b);

 jawaban.forEach((j,n)=>{
  let l=document.createElement("label");
  let r=document.createElement("input");
  let t=document.createElement("span");

  r.type="radio";
  r.name="q"+i;
  r.value=n;
  t.textContent=j;

  r.addEventListener("change",cek);
  l.append(r,t);
  d.appendChild(l);
 });

 area.appendChild(d);
});

function cek(){
 let n=soal.filter((_,i)=>
  document.querySelector('input[name="q'+i+'"]:checked')
 ).length;

 document.getElementById("btn").disabled=n!==9;
}

document.getElementById("tes").addEventListener("submit",e=>{
 e.preventDefault();

 let total=0;

 soal.forEach((s,i)=>{
  total+=Number(
   document.querySelector('input[name="q'+i+'"]:checked').value
  );
 });

 let kategori,keterangan;

 if(total<=4){
  kategori="Minimal";
  keterangan="Gejala depresi yang dilaporkan berada pada tingkat minimal.";
 }else if(total<=9){
  kategori="Ringan";
  keterangan="Gejala depresi yang dilaporkan berada pada tingkat ringan.";
 }else if(total<=14){
  kategori="Sedang";
  keterangan="Gejala depresi yang dilaporkan berada pada tingkat sedang.";
 }else if(total<=19){
  kategori="Cukup berat";
  keterangan="Gejala depresi yang dilaporkan berada pada tingkat cukup berat.";
 }else{
  kategori="Berat";
  keterangan="Gejala depresi yang dilaporkan berada pada tingkat berat.";
 }

 document.getElementById("skor").textContent=total+"/27";
 document.getElementById("kategori").textContent=kategori;
 document.getElementById("keterangan").textContent=keterangan;

 let q9=Number(
  document.querySelector('input[name="q8"]:checked').value
 );

 document.getElementById("catatan9").textContent=q9>0
 ? "Jawaban nomor 9 menunjukkan adanya pikiran tentang kematian atau menyakiti diri. Hal ini perlu segera dibicarakan dengan tenaga kesehatan atau orang tepercaya, berapa pun skor totalnya."
 : "Jawaban nomor 9: tidak pernah.";

 document.getElementById("hasil").style.display="block";
 document.getElementById("hasil").scrollIntoView({behavior:"smooth"});
});

function ulang(){
 document.getElementById("tes").reset();
 document.getElementById("hasil").style.display="none";
 document.getElementById("btn").disabled=true;
 window.scrollTo(0,0);
}
</script>

</body>
</html>
